	/// Calendar year (from yr: 0 = 2011, 1 = 2012)
	column Year = FORMAT(2011 + data_days[yr], "0")
		dataType: string
		lineageTag: 8975df05-f7af-45a6-859f-ed0f4e9c2fe9
		summarizeBy: none
		sortByColumn: yr

	/// Short month name, sorted by mnth
	column Month = FORMAT(DATE(2000, data_days[mnth], 1), "MMM")
		dataType: string
		lineageTag: 70502560-f179-4fcc-b319-1e984bfa5960
		summarizeBy: none
		sortByColumn: mnth

	/// Season label. Codes follow actual dates (1 starts 1 Jan = Winter); the raw Readme's labels are off by one.
	column 'Season Name' = SWITCH(data_days[season], 1, "Winter", 2, "Spring", 3, "Summer", 4, "Fall")
		dataType: string
		lineageTag: b58bb225-3782-4de9-b70c-aa59b85e2a02
		summarizeBy: none
		sortByColumn: season

	/// temp is normalised (divided by 41 max); this converts back to °C
	column 'Temperature (°C)' = ROUND(data_days[temp] * 41, 1)
		dataType: double
		formatString: 0.0
		lineageTag: 22ef144f-189c-4666-ad9d-fcd63fbd823b
		summarizeBy: none

