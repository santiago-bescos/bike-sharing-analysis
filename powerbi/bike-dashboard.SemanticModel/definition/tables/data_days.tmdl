table data_days
	lineageTag: e1b994cf-4d97-41f5-bb47-027c356f0a67

	/// Total bikes rented
	measure 'Total Rentals' = SUM(data_days[cnt])
		formatString: #,0
		displayFolder: Measures
		lineageTag: 81cb69a3-04fe-4c12-80ee-34dac2a7e853

	/// Mean bikes rented per day
	measure 'Avg Daily Rentals' = AVERAGE(data_days[cnt])
		formatString: #,0
		displayFolder: Measures
		lineageTag: 26da7479-cf5d-4ef8-966e-3a6f55bfdc45

	/// Share of rentals made by registered users
	measure 'Registered Share' = DIVIDE(SUM(data_days[registered]), SUM(data_days[cnt]))
		formatString: 0.0%
		displayFolder: Measures
		lineageTag: 9008d9a7-52b2-46a9-b54c-fea8889cefff

	/// Mean casual rentals per day
	measure 'Avg Casual Riders' = AVERAGE(data_days[casual])
		formatString: #,0
		displayFolder: Measures
		lineageTag: e153821d-1349-4cad-91f6-5a117e06a8e0

	/// Mean registered rentals per day
	measure 'Avg Registered Riders' = AVERAGE(data_days[registered])
		formatString: #,0
		displayFolder: Measures
		lineageTag: 81cb0ec6-8388-4541-9adc-604d36d6a5e9

	/// Number of days in the current filter
	measure Days = COUNTROWS(data_days)
		formatString: #,0
		displayFolder: Measures
		lineageTag: e6765d87-1255-4b1e-960f-c487f6ad6d1b

